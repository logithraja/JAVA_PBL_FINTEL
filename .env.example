# Fintel Environment Configuration Example
# Duplicate this file as .env in the root directory and configure with your values.

# Database Settings (Dev Profile)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintel_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication
JWT_SECRET=fintelSuperSecretKeyThatIsAtLeast32BytesLongForSecurity!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Multi-LLM AI Providers (Optional: configure one or more for AI features)
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Client Backend URL
FINTEL_API_URL=http://localhost:8080
